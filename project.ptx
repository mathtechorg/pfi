<?xml version="1.0" encoding="utf-8"?>
<!-- This file, the project manifest, provides the overall configuration for your PreTeXt project. To edit the content of your document, open `source/main.ptx`. See https://pretextbook.org/doc/guide/html/processing-CLI.html#cli-project-manifest. -->
<project ptx-version="2" cname="pfi.mathtech.org">
  <targets>
    <target name="web" format="html" deploy-dir="web">
    </target>
    <target name="web-annotated" format="html" deploy-dir="annotated">
      <stringparams debug.html.annotate="yes"/>
      </target>
    <target name="print" format="pdf" deploy-dir="print"/>
  </targets>
</project>
