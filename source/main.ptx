<?xml version='1.0' encoding='utf-8'?>

<pretext xml:lang="en-US" xmlns:xi="http://www.w3.org/2001/XInclude">
  <!-- we first include a file which contains the docinfo element: -->
  <xi:include href="./meta-docinfo.ptx" />
  <book xml:id="pfi">
    <!-- The book needs a title and can have a subtitle  -->
    <title>PreTeXt for Instructors</title>

    <!-- Now we include files containing each main devision.       -->
    <!-- First a frontmatter for prefaces and such. Maybe comment  -->
    <!-- out for now and write this when the book is more complete -->
    <xi:include href="./frontmatter.ptx" />
    <xi:include href="./ch-introduction.ptx" />
    <xi:include href="./ch-setup.ptx" />
    <xi:include href="./ch-workflow.ptx" />
    <xi:include href="./ch-structure.ptx" />
    <xi:include href="./ch-components.ptx" />
    <xi:include href="./ch-content.ptx" />
    <!-- A chapter on sharing materials, reusing materials from previous semesters, etc? -->
    <!--
    <xi:include href="./ch-sharing.ptx" />
    -->
    <xi:include href="./ch-customization.ptx" />
    <xi:include href="./ch-project.ptx"/>
    <xi:include href="./ch-converting-to-pretext.ptx" />
    <!-- Finaly we place the backmatter in its own file and inlcude-->
    <xi:include href="./backmatter.ptx" />
  </book>
</pretext>
